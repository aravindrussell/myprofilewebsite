# ---- Public site (read at build time by Vite; safe to expose) ----
# Formspree form ID (the part after https://formspree.io/f/). Leave empty to show
# mailto + LinkedIn buttons instead of a contact form.
VITE_FORMSPREE_ID=
# Canonical site URL used for SEO tags, sitemap.xml and robots.txt.
VITE_SITE_URL=https://aravindrusselportfolio.vercel.app

# ---- Local admin API (dev only, never deployed) ----
# The API refuses to start unless ENV=dev.
ENV=dev
API_PORT=8787
# Optional: point the API at another content folder (used by tests).
# CONTENT_DIR=
